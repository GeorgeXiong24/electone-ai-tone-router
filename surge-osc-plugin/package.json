{
  "name": "@electone/surge-osc-tools",
  "description": "Set and query Surge XT synthesizer parameters over OSC",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./osc-client": "./lib/osc-client.js",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "tsconfig.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
